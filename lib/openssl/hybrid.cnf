# Key exchange for the gateway -> cloud hop, loaded through OPENSSL_CONF (see
# lib/README.md). It applies to the whole process, but the contexts that pin a
# group in lib.tls (reader port, control panel) override it.
#
# Prefers the post-quantum hybrid X25519MLKEM768 and falls back to classical
# X25519 for peers without ML-KEM. The * sends a key share for both groups in
# the first ClientHello, so an old peer costs no HelloRetryRequest round trip.

# Fail on errors in this file: otherwise OpenSSL ignores it and uses its defaults.
config_diagnostics = 1
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_module

[ssl_module]
system_default = gateway_cloud

[gateway_cloud]
Groups = *X25519MLKEM768:*X25519
