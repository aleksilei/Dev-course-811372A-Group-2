# The OpenSSL that the -openssl<version> cloud and gateway images build in
# (SCRUM-55), loaded ahead of the base image's. CI reports when the base
# image already meets the simulated ML-KEM advisory's 3.5.7 patch threshold.
#
# Read by the Makefile (which exports it to docker compose), the e2e tests and
# the release workflow. The checksum is the one OpenSSL publishes for the
# release tarball; bump both together.
OPENSSL_VERSION=3.5.9
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
